# Copy this file to .env for local development. Never commit .env.
DATABASE_URL=postgresql://glib:glib@127.0.0.1:5432/glib
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_SSL=false
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_MINUTES=30
MESSAGE_RETENTION_DAYS=90
TRUST_PROXY=false

# Optional dedicated-server room repository sync. Set both or neither.
# Generate a unique high-entropy token (for example, 32 random bytes encoded as base64url).
# Never commit or share the production token.
# GLIB_ROOM_SYNC_TOKEN=
# GLIB_ROOM_SYNC_OWNER_UUID=00000000-0000-0000-0000-000000000000
