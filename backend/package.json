{
  "name": "glib-network-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/*.test.js\"",
    "admin": "node dist/admin-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.1.0",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
